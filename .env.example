# LLM: choose one provider. Without a key the app runs in DEMO mode (returns sample result).
LLM_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=                      # optional override, e.g. claude-sonnet-4-5 / gpt-4o-mini

# Paywall: Stripe Payment Link (test mode is fine for the hackathon). Empty = demo unlock button.
NEXT_PUBLIC_PAYMENT_LINK=

# Public site URL (for metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
