  {"id": "common_praise_01","voice": "hq","mode": "common","kind": "praise","ageBand": "all","text": "Nicely spotted, pal!","file": "/audio/en/7017b2dea7764b95d9bb.mp3","durationMs": 1580},
  {"id": "common_praise_02","voice": "hq","mode": "common","kind": "praise","ageBand": "all","text": "AIdos copies. Great work!","file": "/audio/en/584028f807aae4b5d471.mp3","durationMs": 2260},
  {"id": "common_praise_03","voice": "hq","mode": "common","kind": "praise","ageBand": "all","text": "You did it! I knew you could.","file": "/audio/en/4ea63710e150804cc304.mp3","durationMs": 2860},
  {"id": "common_praise_04","voice": "hq","mode": "common","kind": "praise","ageBand": "all","text": "Nice thinking, pal.","file": "/audio/en/2d2bdb95ba04769ed33b.mp3","durationMs": 1340},
  {"id": "common_praise_05","voice": "hq","mode": "common","kind": "praise","ageBand": "all","text": "That's another clue for the team.","file": "/audio/en/1152f0e8f501c44c6195.mp3","durationMs": 1780},
  {"id": "common_praise_06","voice": "hq","mode": "common","kind": "praise","ageBand": "all","text": "Well done. You kept looking!","file": "/audio/en/ff0fd5d7985d3268dbd2.mp3","durationMs": 2210},
  {"id": "common_praise_07","voice": "hq","mode": "common","kind": "praise","ageBand": "all","text": "Good work, detective.","file": "/audio/en/7a451d0bfc4d551badcb.mp3","durationMs": 1540},
  {"id": "common_praise_08","voice": "hq","mode": "common","kind": "praise","ageBand": "all","text": "You found it. High five!","file": "/audio/en/db8cf1b4246adb250d0c.mp3","durationMs": 2090},
  {"id": "common_praise_09","voice": "hq","mode": "common","kind": "praise","ageBand": "all","text": "Excellent teamwork out there.","file": "/audio/en/e47626d33b48f43357ec.mp3","durationMs": 1780},
  {"id": "common_praise_10","voice": "hq","mode": "common","kind": "praise","ageBand": "all","text": "You made that look easy!","file": "/audio/en/4daa8215d5381eaf38f1.mp3","durationMs": 1730},
  {"id": "common_retry_01","voice": "hq","mode": "common","kind": "retry","ageBand": "all","text": "Good try, pal. On to the next assignment.","file": "/audio/en/e8fd3b5e38c71d5c6dd6.mp3","durationMs": 2860},
  {"id": "common_retry_02","voice": "hq","mode": "common","kind": "retry","ageBand": "all","text": "Let's try another clue together.","file": "/audio/en/26686a61e7e616254910.mp3","durationMs": 2060},
  {"id": "common_retry_03","voice": "hq","mode": "common","kind": "retry","ageBand": "all","text": "That was a tricky one. Keep exploring.","file": "/audio/en/fe15bddf240f75dd88e4.mp3","durationMs": 2980},
  {"id": "common_retry_04","voice": "hq","mode": "common","kind": "retry","ageBand": "all","text": "Every try helps us learn.","file": "/audio/en/8d9c4be2cdbb5de34bd3.mp3","durationMs": 1940},
  {"id": "common_retry_05","voice": "hq","mode": "common","kind": "retry","ageBand": "all","text": "Take a breath. We've got another clue.","file": "/audio/en/26d4251bc4b0adc80b3a.mp3","durationMs": 2780},
  {"id": "common_retry_06","voice": "hq","mode": "common","kind": "retry","ageBand": "all","text": "Good effort, pal. Ready to try again?","file": "/audio/en/1f4635782684d8cde719.mp3","durationMs": 2660},
  {"id": "common_transition_01","voice": "hq","mode": "common","kind": "transition","ageBand": "all","text": "Time's up. Let's try a new assignment.","file": "/audio/en/e324aa79cf513882b869.mp3","durationMs": 2540},
  {"id": "common_transition_02","voice": "hq","mode": "common","kind": "transition","ageBand": "all","text": "Stand by, pal. Another clue is coming.","file": "/audio/en/60f58b78086d3c27a578.mp3","durationMs": 2860},
  {"id": "common_transition_03","voice": "hq","mode": "common","kind": "transition","ageBand": "all","text": "Next clue coming in loud and clear.","file": "/audio/en/99c184379495228badc4.mp3","durationMs": 2140},
  {"id": "common_transition_04","voice": "hq","mode": "common","kind": "transition","ageBand": "all","text": "Let's see what's next on the map.","file": "/audio/en/42fbf7f6e07742089331.mp3","durationMs": 1970},
  {"id": "common_transition_05","voice": "hq","mode": "common","kind": "transition","ageBand": "all","text": "Ready for a fresh assignment?","file": "/audio/en/7c49fccb50ed464bc6ec.mp3","durationMs": 1780},
  {"id": "common_transition_06","voice": "hq","mode": "common","kind": "transition","ageBand": "all","text": "Back to AIdos for the next clue.","file": "/audio/en/f8b8de7995c44ea7535e.mp3","durationMs": 1970},
  {"id": "common_recall_01","voice": "hq","mode": "common","kind": "recall","ageBand": "all","text": "Last time you tracked down objects for AIdos.","file": "/audio/en/55edda7659f110e82cbb.mp3","durationMs": 2620},
  {"id": "common_recall_02","voice": "hq","mode": "common","kind": "recall","ageBand": "all","text": "Last time you spotted clues on the road.","file": "/audio/en/4fa613d1c2cf9434bc4a.mp3","durationMs": 2140},
  {"id": "common_recall_03","voice": "hq","mode": "common","kind": "recall","ageBand": "all","text": "Last time you stayed on your safe spot.","file": "/audio/en/e14a3e48e24cced0e356.mp3","durationMs": 2140},
  {"id": "common_recall_04","voice": "hq","mode": "common","kind": "recall","ageBand": "all","text": "Last time your team found a soft clue.","file": "/audio/en/2080bd0e4ec00c7a0e38.mp3","durationMs": 2380},
  {"id": "common_recall_05","voice": "hq","mode": "common","kind": "recall","ageBand": "all","text": "Last time you noticed colors on the road.","file": "/audio/en/f50df62f6bfcb6af808d.mp3","durationMs": 2210},
  {"id": "common_recall_06","voice": "hq","mode": "common","kind": "recall","ageBand": "all","text": "Last time you held still like a statue.","file": "/audio/en/d0d0741550e3facab9d7.mp3","durationMs": 2380},
  {"id": "common_recall_07","voice": "hq","mode": "common","kind": "recall","ageBand": "all","text": "Last time you looked for shapes around base.","file": "/audio/en/9377c276b53df2cb2079.mp3","durationMs": 2450},
  {"id": "common_recall_08","voice": "hq","mode": "common","kind": "recall","ageBand": "all","text": "Last time you helped AIdos crack a clue.","file": "/audio/en/efcc73fd6060b226d6ea.mp3","durationMs": 2330},
  {"id": "common_outro_01","voice": "hq","mode": "common","kind": "outro","ageBand": "all","text": "Mission complete. Great work, agents!","file": "/audio/en/1cdac88d8abf6e01f275.mp3","durationMs": 2690},
  {"id": "common_outro_02","voice": "hq","mode": "common","kind": "outro","ageBand": "all","text": "That's a wrap, team. Thanks for exploring!","file": "/audio/en/6990df8ce04b362eb5f6.mp3","durationMs": 2380},
  {"id": "common_outro_03","voice": "hq","mode": "common","kind": "outro","ageBand": "all","text": "Base is signing off. You did a great job.","file": "/audio/en/6e8c9226ec8c04c91957.mp3","durationMs": 3050},
  {"id": "common_outro_04","voice": "hq","mode": "common","kind": "outro","ageBand": "all","text": "Mission complete. See you on the next adventure!","file": "/audio/en/37998c79043f2e343f90.mp3","durationMs": 2860},
  {"id": "common_intro_01","voice": "hq","mode": "common","kind": "intro","ageBand": "all","text": "Hey pal! Ready for your next mission?","file": "/audio/en/098560d87929b0561ff2.mp3","durationMs": 2930},
  {"id": "common_intro_02","voice": "hq","mode": "common","kind": "intro","ageBand": "all","text": "AIdos here. Let's explore together.","file": "/audio/en/d22edf00e41fb6e1e709.mp3","durationMs": 2660},
