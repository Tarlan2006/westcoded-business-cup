[
  {"id": "lava_alert","voice": "hq","mode": "lava","kind": "intro","ageBand": "all","text": "Lava alert! Stay on the floor. Walk to your safe spot.","file": "/audio/lava/lava_alert.mp3","durationMs": 4100},
  {"id": "lava_freeze_1","voice": "hq","mode": "lava","kind": "task","ageBand": "all","text": "Keep both feet on the floor and freeze like a statue.","file": "/audio/lava/lava_freeze_1.mp3","durationMs": 3340},
