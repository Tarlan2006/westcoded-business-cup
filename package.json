{
  "name": "mission-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check-content": "node scripts/check-content.mjs",
    "check-sketch": "node src/games/sketch/scoreSketch.check.ts",
    "check-space": "node src/games/space/scale.check.ts",
    "gen-audio": "node scripts/gen-audio.mjs",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "postinstall": "patch-package",
    "smoke": "node scripts/smoke-prod.mjs",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters && tsc --noEmit -p tsconfig.worker.json --noUnusedLocals --noUnusedParameters"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "pocket-tts-js": "0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "patch-package": "^8.0.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "wrangler": "4.160.0"
  }
}
